# Credenciais locais (senha do Wi-Fi real etc.) nunca vão para o repositório
secrets.h
*.env

# PlatformIO / editores
.pio/
.vscode/
__pycache__/
*.db

# Dados brutos da Emlurb (grandes, baixados do portal, não vão para o Git)
applications/ml/data/raw/
.ipynb_checkpoints/

# MLflow local (tracking em sqlite + artefatos) e banco do coletor
applications/ml/mlflow.db
applications/ml/mlruns/
mlruns/
applications/backend/dados/

# Parque de luminárias simulado: banco SQLite local e estado do simulador (gerados de novo com
# "python applications/simulador/parque.py gerar"); o resumo da calibração fica no Git
applications/ml/data/simulado/*
!applications/ml/data/simulado/calibracao.json
.pytest_cache/
# Modelo do detector de anomalias: ~5 MB (o LOF guarda os vizinhos) e é retreinado sozinho pelo serviço
# "anomalia" a cada 2.000 leituras novas (e treinado na hora se o arquivo não existir)
applications/ml/models/modelo_anomalia.joblib
